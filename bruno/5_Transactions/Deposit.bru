meta {
  name: Deposit
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/transactions/deposit
  body: json
  auth: inherit
}

body:json {
  {
    "account_id": "{{chequingId}}",
    "amount": 100.00,
    "description": "Initial deposit"
  }
}

script:post-response {
  bru.setEnvVar("depositTxnId", res.body.transaction_id);
}

settings {
  encodeUrl: true
  timeout: 0
}
