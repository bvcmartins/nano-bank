meta {
  name: Reverse
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/transactions/{{withdrawTxnId}}/reverse
  body: json
  auth: inherit
}

body:json {
  {
    "reason": "customer dispute"
  }
}

docs {
  Reverses the Withdraw request (a refund) — this always succeeds because it
  credits the customer back. Reversing a DEPOSIT instead can fail with
  INSUFFICIENT_FUNDS if the deposited money was already spent (v1 reversals
  don't allow a negative clawback). Reversing again returns 400 (already reversed).
}

settings {
  encodeUrl: true
  timeout: 0
}
