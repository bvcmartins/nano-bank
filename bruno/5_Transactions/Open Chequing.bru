meta {
  name: Open Chequing
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/accounts
  body: json
  auth: inherit
}

body:json {
  {
    "account_type": "chequing"
  }
}

script:post-response {
  bru.setEnvVar("chequingId", res.body.account_id);
}

settings {
  encodeUrl: true
  timeout: 0
}
