# Ollama cloud (OpenAI-compatible) backend
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
MANAGER_MODEL=glm-5.2
MANAGER_FALLBACK_MODEL=glm-4.7

# Dedicated local Qdrant (NOT ragu). In-network: http://qdrant:6333
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=nano_manager_memory

# Read-only nano-bank Postgres (Kind via host port-forward).
# On the host: ::1 ; inside a container: host.containers.internal
DB_HOST=::1
DB_PORT=5432
DB_NAME=nano_bank_db
DB_USER=nanobank_user
DB_PASSWORD=secure_nano_password_2024!

# nano-bank API (act calls + seed login)
NANO_BANK_API=http://localhost:8081

# Agentic Branch (a2a) auth + act guardrails
BRANCH_SERVICE_TOKEN=
ACT_MAX_PER_TX=1000
CONFIRM_TTL_S=300

# MCP server (unpublished; in-network only). In-network: http://mcp:8087/mcp
MCP_URL=http://localhost:8087/mcp

# Published ports
BRANCH_PORT=8086
CONSOLE_PORT=8505

# nano-bank-crm's own agent identity for this personal manager — see
# nano-bank-crm's packages/db/src/provision-personal-manager-agent.ts, run once
# per deployment. CRM_AGENT_SECRET is printed exactly once by that script.
CRM_BASE_URL=http://localhost:3000
CRM_TENANT_SLUG=acme
CRM_AGENT_ID=
CRM_AGENT_SECRET=
# Matches nano-bank-crm's PERSONAL_MANAGER_LOOKUP_TOKEN. Their review found
# this and CO_PROVISIONING_TOKEN sharing one dev placeholder, so dev/CI never
# exercised the credential split — nano-bank-crm's own .env.example now gives
# the two distinct values; keep this one in sync with theirs, not with
# CRM_PROVISIONING_TOKEN's default in the coo worktree.
CRM_LOOKUP_TOKEN=dev-only-not-a-real-secret-lookup
# The COO's /ask endpoint — directed to provision CRM access on a cache miss.
COO_BASE_URL=http://localhost:8093
