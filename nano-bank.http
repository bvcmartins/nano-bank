# nano-bank API
# Run requests top to bottom in order — each one uses the response from the previous.
# Install extension first: code --install-extension humao.rest-client

@baseUrl = http://localhost:8081

# ─────────────────────────────────────────────────────────────
# 1. Health check
# ─────────────────────────────────────────────────────────────

GET {{baseUrl}}/health
Accept: application/json

###

# ─────────────────────────────────────────────────────────────
# 2. Create customer
#    Saves response so step 3 can read customer_id from it.
# ─────────────────────────────────────────────────────────────

# @name createCustomer
POST {{baseUrl}}/api/v1/customers
Content-Type: application/json

{
    "email": "jane.doe2@example.com",
    "phone_number": "4161234567",
    "first_name": "Jane",
    "last_name": "Doe",
    "date_of_birth": "1990-05-15",
    "sin": "123456789",
    "password": "securepass123"
}

###

# ─────────────────────────────────────────────────────────────
# 3. Open credit card account
#    Uses customer_id from step 2.
#    Saves response so step 4 can read account_id from it.
# ─────────────────────────────────────────────────────────────

# @name openAccount
POST {{baseUrl}}/api/v1/accounts
Content-Type: application/json

{
    "customer_id": "{{createCustomer.response.body.customer_id}}",
    "account_type": "credit_card"
}

###

# ─────────────────────────────────────────────────────────────
# 4. Authorize purchase
#    Uses account_id from step 3.
#    Saves response so step 5 can read auth_id from it.
# ─────────────────────────────────────────────────────────────

# @name authorize
POST {{baseUrl}}/api/v1/cards/authorize
Content-Type: application/json

{
    "account_id": "{{openAccount.response.body.account_id}}",
    "amount": 99.99,
    "merchant": "Tim Hortons"
}

###

# ─────────────────────────────────────────────────────────────
# 5. Capture authorization
#    Uses auth_id from step 4.
#    Posts the double-entry journal entry to the ledger.
# ─────────────────────────────────────────────────────────────

POST {{baseUrl}}/api/v1/cards/capture
Content-Type: application/json

{
    "auth_id": "{{authorize.response.body.auth_id}}"
}

###

# ─────────────────────────────────────────────────────────────
# 6. Settle all captured purchases
#    Nets VISA_CLEARING against BANK_SETTLEMENT in one batch.
# ─────────────────────────────────────────────────────────────

POST {{baseUrl}}/api/v1/cards/settle
Content-Type: application/json

{}

###

# ─────────────────────────────────────────────────────────────
# 7. List accounts for customer
#    Uses customer_id from step 2. Returns Vec<AccountSummary>.
# ─────────────────────────────────────────────────────────────

GET {{baseUrl}}/api/v1/accounts?customer_id={{createCustomer.response.body.customer_id}}
Accept: application/json

###

# ─────────────────────────────────────────────────────────────
# 8. Get single account (full details)
#    Uses account_id from step 3. Returns AccountResponse.
# ─────────────────────────────────────────────────────────────

GET {{baseUrl}}/api/v1/accounts/{{openAccount.response.body.account_id}}
Accept: application/json

###

# ─────────────────────────────────────────────────────────────
# 9. Get balance with active holds
#    Uses account_id from step 3. Returns balance + holds[].
#    Run after step 4 (authorize) to see an open hold in holds[].
# ─────────────────────────────────────────────────────────────

GET {{baseUrl}}/api/v1/accounts/{{openAccount.response.body.account_id}}/balance
Accept: application/json

###

# ─────────────────────────────────────────────────────────────
# 10. Get customer profile
#     Uses customer_id from step 2. Returns CustomerResponse.
# ─────────────────────────────────────────────────────────────

GET {{baseUrl}}/api/v1/customers/profile?customer_id={{createCustomer.response.body.customer_id}}
Accept: application/json

###

# ═════════════════════════════════════════════════════════════
# TRANSACTIONS: deposit → transfer → withdrawal → history
# Uses a fresh customer with two deposit accounts (chequing + savings).
# Deposit/withdrawal post to the GL core — a core must be running.
# ═════════════════════════════════════════════════════════════

# @name txnCustomer
POST {{baseUrl}}/api/v1/customers
Content-Type: application/json

{
    "email": "txn.demo@example.com",
    "phone_number": "4165550000",
    "first_name": "Txn",
    "last_name": "Demo",
    "date_of_birth": "1990-05-15",
    "sin": "123456780",
    "password": "securepass123"
}

###

# 11. Open chequing account A
# @name acctA
POST {{baseUrl}}/api/v1/accounts
Content-Type: application/json

{
    "customer_id": "{{txnCustomer.response.body.customer_id}}",
    "account_type": "chequing"
}

###

# 12. Open savings account B
# @name acctB
POST {{baseUrl}}/api/v1/accounts
Content-Type: application/json

{
    "customer_id": "{{txnCustomer.response.body.customer_id}}",
    "account_type": "savings"
}

###

# 13. Deposit 1000 into A  (customer credit / EXTERNAL_CASH debit; GL: Bank↔Payable)
POST {{baseUrl}}/api/v1/transactions/deposit
Content-Type: application/json

{
    "account_id": "{{acctA.response.body.account_id}}",
    "amount": 1000.00,
    "description": "Payday deposit"
}

###

# 14. Transfer 400 from A to B  (local double-entry; no GL post)
POST {{baseUrl}}/api/v1/transactions/transfer
Content-Type: application/json

{
    "from_account_id": "{{acctA.response.body.account_id}}",
    "to_account_id": "{{acctB.response.body.account_id}}",
    "amount": 400.00,
    "description": "Move to savings",
    "idempotency_key": "demo-transfer-001"
}

###

# 15. Withdraw 100 from A  (GL: Payable↔Bank; daily limit enforced)
POST {{baseUrl}}/api/v1/transactions/withdrawal
Content-Type: application/json

{
    "account_id": "{{acctA.response.body.account_id}}",
    "amount": 100.00,
    "description": "ATM withdrawal"
}

###

# 16. Transaction history for account A (newest first, entries hydrated)
GET {{baseUrl}}/api/v1/transactions?account_id={{acctA.response.body.account_id}}&limit=20
Accept: application/json

###
